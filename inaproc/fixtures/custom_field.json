[
    {
        "doctype": "Custom Field",
        "name": "Item-custom_inventory_section",
        "dt": "Item",
        "fieldname": "custom_inventory_section",
        "fieldtype": "Section Break",
        "insert_after": "safety_stock",
        "label": "Custom Inventory Planning"
    },
    {
        "doctype": "Custom Field",
        "name": "Item-custom_calculated_min_qty",
        "dt": "Item",
        "fieldname": "custom_calculated_min_qty",
        "fieldtype": "Float",
        "insert_after": "custom_inventory_section",
        "label": "Calculated Min Qty",
        "no_copy": 1,
        "read_only": 1,
        "description": "Minimum quantity calculated based on sales history or demand."
    },
    {
        "doctype": "Custom Field",
        "name": "Item-custom_calculated_max_qty",
        "dt": "Item",
        "fieldname": "custom_calculated_max_qty",
        "fieldtype": "Float",
        "insert_after": "custom_calculated_min_qty",
        "label": "Calculated Max Qty",
        "no_copy": 1,
        "read_only": 1,
        "description": "Maximum quantity calculated based on sales history or demand."
    },
    {
        "doctype": "Custom Field",
        "name": "Item-custom_safety_stock",
        "dt": "Item",
        "fieldname": "custom_safety_stock",
        "fieldtype": "Float",
        "insert_after": "custom_calculated_max_qty",
        "label": "Safety Stock",
        "description": "Buffer stock to prevent stockouts."
    },
    {
        "doctype": "Custom Field",
        "name": "Item-custom_lead_time",
        "dt": "Item",
        "fieldname": "custom_lead_time",
        "fieldtype": "Int",
        "insert_after": "custom_safety_stock",
        "label": "Lead Time (Days)",
        "description": "Time in days between placing an order and receiving it."
    },
    {
        "doctype": "Custom Field",
        "name": "Purchase Order-custom_po_support_docs_section",
        "dt": "Purchase Order",
        "fieldname": "custom_po_support_docs_section",
        "fieldtype": "Section Break",
        "label": "Dokumen Pendukung",
        "insert_after": "payment_schedule",
        "collapsible": 1,
        "module": "inaproc"
    },
    {
        "doctype": "Custom Field",
        "name": "Purchase Order-custom_upload_support_doc",
        "dt": "Purchase Order",
        "fieldname": "custom_upload_support_doc",
        "fieldtype": "Button",
        "label": "Unggah Dokumen",
        "insert_after": "custom_po_support_docs_section",
        "module": "inaproc"
    },
    {
        "doctype": "Custom Field",
        "name": "Purchase Order-custom_po_support_docs_table",
        "dt": "Purchase Order",
        "fieldname": "custom_po_support_docs_table",
        "fieldtype": "Table",
        "label": "Dokumen Pendukung",
        "options": "PO Support Document",
        "insert_after": "custom_upload_support_doc",
        "module": "inaproc"
    },
    {
        "doctype": "Custom Field",
        "name": "Item Group-akronim",
        "dt": "Item Group",
        "fieldname": "akronim",
        "fieldtype": "Data",
        "insert_after": "item_group_name",
        "label": "Akronim",
        "no_copy": 1,
        "in_list_view": 1
    },
    {
        "doctype": "Custom Field",
        "name": "Purchase Receipt-custom_qc_validation_summary",
        "dt": "Purchase Receipt",
        "fieldname": "custom_qc_validation_summary",
        "fieldtype": "HTML",
        "label": "Ringkasan Validasi QC",
        "insert_after": "scan_barcode",
        "hidden": 1
    } 
]